# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase — get these from your Supabase project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Admin panel password — used for all /admin/* endpoints
ADMIN_PASSWORD=change-me-before-deployment

# Optional: Slack incoming webhook URL for scraper alerts
ALERT_WEBHOOK_URL=
